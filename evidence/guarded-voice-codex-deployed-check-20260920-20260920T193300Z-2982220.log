ion back by the voice tool.\n ask("Switch the selected Codex session to "+names[0]+".","mcp__codex__select_session",contexts[0])\n assert get(contexts[0])["selected_session_id"]==rows[names[0]]["session_id"]\n assert get(contexts[1])["selected_session_id"]==rows[names[1]]["session_id"]\n report["checks"]["separate_selections"]=True\n ask("Tell the selected Codex session to implement probe.py containing square(x) that returns x*x, and run Python assertions for square(-3)==9 and square(0)==0. Use only its own project directory.","mcp__codex__send",contexts[0])\n deadline=time.monotonic()+150\n while time.monotonic()<deadline:\n  current=next(r for r in get(contexts[0])["sessions"] if r["name"]==names[0])\n  assert current["state"] not in ["failed","unknown"],current\n  if current["state"]=="idle" and current["thread_id"]:break\n  time.sleep(1)\n else:raise AssertionError(current)\n report["checks"]["real_coding_completion"]=current\n ask("What is the status of the selected Codex session?","mcp__codex__status",contexts[0])\n ask("Read "+rows[names[0]]["cwd"]+"/probe.py using the direct workspace file tools.","mcp__workspace__read_file",contexts[0])\n report["checks"]["direct_read_path"]=rows[names[0]]["cwd"]+"/probe.py"\n for name,context in zip(names,contexts):\n  ask("Archive the finished Codex session named "+name+". Keep all project files.","mcp__codex__archive_session",context)\n assert not any(r["name"] in names for r in get(contexts[0])["sessions"])\n report["checks"]["archived_without_deleting_projects"]=True\n report["passed"]=True\nfinally:\n pathlib.Path("evidence/deployed-check.json").write_text(json.dumps(report,indent=2)+"\\n")\n print(json.dumps({"passed":report.get("passed",False),"checks":report["checks"]},indent=2),flush=True)\n'
